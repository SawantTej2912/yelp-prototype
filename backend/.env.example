# Copy to `backend/.env` and fill in real values. Used by local `uvicorn` and Docker Compose.
# Never commit `backend/.env` (it is gitignored).

# ─── MySQL (local dev: localhost; Docker Compose overrides DB_HOST to `mysql` in compose) ───
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yelp_prototype

# ─── MongoDB (Phase 2+; used by shared/mongo.py — sessions / chat in Mongo in Phase 3) ───
# Local: mongodb://localhost:27017/yelp_prototype
# Docker: mongodb://mongodb:27017/yelp_prototype
MONGO_URI=mongodb://localhost:27017/yelp_prototype

# ─── Kafka (Phase 3+ consumers) ───
# Local: localhost:9092  |  Docker: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── JWT ───
JWT_SECRET=change_me_generate_with_python_secrets_token_hex_32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── Optional AI & tools ───
GEMINI_API_KEY=
TAVILY_API_KEY=
# YELP_API_KEY=
